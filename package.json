{
  "name": "guitar-tuner",
  "version": "0.1.0",
  "description": "Guitar tuner and Markov-chain chord progression composer built with Bun, React and the Web Audio API.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnb8005/guitar-tuner.git"
  },
  "homepage": "https://johnb8005.github.io/guitar-tuner/",
  "bugs": {
    "url": "https://github.com/johnb8005/guitar-tuner/issues"
  },
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "NODE_ENV=production bun src/server.ts",
    "build": "bun run build.ts",
    "typecheck": "bun check",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "dependencies": {
    "@types/three": "^0.182.0",
    "bun-plugin-tailwind": "^0.1.2",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.13.0",
    "tailwindcss": "^4.1.11",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun": "1.4.4"
  }
}
